# فقط برای build محلی (اختیاری)
# SITE_URL=https://bizyaar.ir
# SHOW_DRAFTS=1
# PUBLIC_API_BASE=http://127.0.0.1:8090   # در حالت dev خودکار همین است
#
# اسرار سرور در /etc/bizyaar.env (نه در گیت):
# OTP_SECRET=یک-رشته-تصادفی-بلند
# ADMIN_PHONES=09928710944,09172079245
# FLOWS_DIR=/var/www/bizyaar/flows
# SMS_PROVIDER=melipayamak
# MELIPAYAMAK_USER=...
# MELIPAYAMAK_PASS=...
# MELIPAYAMAK_OTP_BODYID=کد-پترن-OTP
# MELIPAYAMAK_NOTIFY_BODYID=کد-پترن-اعلان
# SMS_MODE=critical            # critical | all | off
# BALE_TOKEN=...
# BALE_CHAT_ID=...             # چت یا گروه مدیر
# BALE_BOT_USERNAME=نام-کاربری-ربات
# BALE_WEBHOOK_SECRET=رشته-تصادفی
# OTP_VIA_BALE=1               # اگر کاربر بله وصل کرده، کد ورود را با بله بفرست
# FILE_RETENTION_DAYS=0        # >0: مدارک پرونده‌های بسته‌شده بعد از N روز پاک شود
# OTP_DEV=1                    # فقط تست محلی؛ هرگز روی سرور واقعی
