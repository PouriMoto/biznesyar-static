---
import { site } from '../config';
interface Props { service?: string; id?: string }
const { service, id } = Astro.props;
const m = (site as any).magnets?.find((x: any) => (id ? x.id === id : x.services.includes(service)));
---
{m && (
  <section class="magnet" data-magnet={m.id} data-file={m.file} data-service={service ?? ''}>
    <h3>{m.title}</h3>
    <p style="margin:0">{m.text}</p>
    <form class="inline magnet-form" novalidate>
      <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="09123456789" aria-label="شماره موبایل" required />
      <button class="btn btn-primary" type="submit">دریافت رایگان</button>
    </form>
    <p class="lead-status" role="status" hidden></p>
    <p class="magnet-done" hidden><a class="btn btn-primary" href={m.file} download target="_blank" rel="noopener" data-track="magnet_download">⬇ دانلود PDF</a></p>
  </section>
)}
<script>
  import '../scripts/lead-magnet';
</script>
