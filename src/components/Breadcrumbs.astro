---
interface Props { items: { name: string; path?: string }[] }
const { items } = Astro.props;
---
<nav aria-label="مسیر صفحه">
  <ol class="crumbs">
    <li><a href="/">خانه</a></li>
    {items.map((it, i) => <li>{it.path && i < items.length - 1 ? <a href={it.path}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>)}
  </ol>
</nav>
